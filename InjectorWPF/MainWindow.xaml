<Window x:Class="InjectorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InjectorWPF"
        Title="DICE INJECTOR"
        Width="700" Height="620"
        MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="{StaticResource Mono}">

    <Border CornerRadius="14" Background="{StaticResource Bg}"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="$" Foreground="{StaticResource Accent}" FontFamily="{StaticResource Mono}"
                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" dice-injector" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource Mono}"
                               FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" v2.0" Foreground="{StaticResource TextDim}" FontFamily="{StaticResource Mono}"
                               FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0"/>
                    <TextBlock x:Name="TitleCursor" Text="&#9614;" Foreground="{StaticResource Accent}"
                               FontFamily="{StaticResource Mono}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="MinBtn" Style="{StaticResource TitleButton}" Click="MinBtn_Click">
                        <TextBlock Text="&#9472;" FontFamily="{StaticResource Mono}" FontSize="14"/>
                    </Button>
                    <Button x:Name="CloseBtn" Style="{StaticResource TitleButtonClose}" Click="CloseBtn_Click" Margin="2,0,0,0">
                        <TextBlock Text="&#10005;" FontFamily="{StaticResource Mono}" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>

            
            <Grid Grid.Row="1" Margin="22,8,22,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="//" Foreground="{StaticResource TextDim}" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text=" PROCESSES" Foreground="{StaticResource TextSecondary}" Style="{StaticResource SectionLabel}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="ProcessCount" Style="{StaticResource SectionLabel}"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="RefreshBtn" Style="{StaticResource TermButton}" Content="REFRESH"
                                Click="RefreshBtn_Click" Padding="12,4" FontSize="10.5"/>
                    </StackPanel>
                </Grid>

                
                <Border Grid.Row="1" Background="{StaticResource BgInput}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource TermPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&gt;" Foreground="{StaticResource Accent}" FontFamily="{StaticResource Mono}"
                                   FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <Grid Grid.Column="1">
                            <TextBlock x:Name="SearchPlaceholder" Text="filter processes..."
                                       Foreground="{StaticResource TextDim}" FontFamily="{StaticResource Mono}"
                                       FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox" Style="{StaticResource TermInput}"
                                     TextChanged="SearchBox_TextChanged" Margin="0,0,10,0" Background="Transparent"/>
                        </Grid>
                    </Grid>
                </Border>

                
                <Border Grid.Row="3" Style="{StaticResource TermPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="12,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PID" Foreground="{StaticResource TextDim}"
                                       FontFamily="{StaticResource Mono}" FontSize="10.5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="NAME" Foreground="{StaticResource TextDim}"
                                       FontFamily="{StaticResource Mono}" FontSize="10.5" VerticalAlignment="Center"/>
                        </Grid>
                        <ListBox x:Name="ProcessList" Grid.Row="1" Style="{StaticResource TermList}"
                                 MouseDoubleClick="ProcessList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Pid}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Bg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Bg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                
                <Grid Grid.Row="5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="//" Foreground="{StaticResource TextDim}" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text=" DLL LIBRARY" Foreground="{StaticResource TextSecondary}" Style="{StaticResource SectionLabel}"/>
                    </StackPanel>
                </Grid>

                
                <Border Grid.Row="6" Background="{StaticResource BgInput}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource TermPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=DllBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&gt;" Foreground="{StaticResource Accent}" FontFamily="{StaticResource Mono}"
                                   FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <Grid Grid.Column="1">
                            <TextBlock x:Name="DllPlaceholder" Text="C:\path\to\payload.dll"
                                       Foreground="{StaticResource TextDim}" FontFamily="{StaticResource Mono}"
                                       FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="DllBox" Style="{StaticResource TermInput}"
                                     KeyDown="DllBox_KeyDown" TextChanged="DllBox_TextChanged"
                                     Margin="0,0,10,0" Background="Transparent"/>
                        </Grid>
                        <Button x:Name="BrowseBtn" Grid.Column="2" Style="{StaticResource TermButton}"
                                Content="BROWSE" Click="BrowseBtn_Click" Margin="0,0,8,0"/>
                    </Grid>
                </Border>

                
                <Button x:Name="InjectBtn" Grid.Row="8" Style="{StaticResource InjectButton}"
                        Content="INJECT" Click="InjectBtn_Click" HorizontalAlignment="Center" MinWidth="240" Margin="0,2,0,14"/>
            </Grid>

            
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}"
                    Background="{StaticResource BgPanel}">
                <Grid Margin="18,0,18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTag" Style="{StaticResource StatusTag}" Text="[ok]"
                                   Foreground="{StaticResource Accent}"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource StatusText}" Text=" ready"
                                   Margin="8,0,0,0"/>
                        <TextBlock x:Name="StatusCursor" Style="{StaticResource TermCursor}" Text="&#9614;"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
